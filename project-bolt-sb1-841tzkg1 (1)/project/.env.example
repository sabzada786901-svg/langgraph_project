# friendly_AI Frontend Environment Variables
# Copy this file to .env and adjust values

# Base URL of your Python LangGraph backend
VITE_API_BASE_URL=http://localhost:8000

# Enable mock mode when the backend is not connected (true/false)
# When true, the app uses src/services/mockApi.ts for responses
VITE_USE_MOCK=true

# Supabase (pre-populated automatically by Bolt — do not change)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: never place API keys (GROQ_API_KEY, OPENROUTER_API_KEY) in the frontend.
# They belong ONLY to the backend.
